rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in
        ['spRteEkQRHaCUMizkijKff1ZzRI3', 'O0FJorXpLvZnLnXNPYEsS6udTAG3'];
    }
    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    // {h: 0-360, s: 0-100, l: 0-100} — the shape every car color is stored
    // in, whether it came from the hue pack or the saturation/brightness
    // pack, so equipping one is always the same simple field-copy.
    function isHsl(c) {
      return c.keys().hasOnly(['h', 's', 'l'])
        && c.h is number && c.h >= 0 && c.h <= 360
        && c.s is number && c.s >= 0 && c.s <= 100
        && c.l is number && c.l >= 0 && c.l <= 100;
    }

    // config/invite holds the current invite code. No player may ever read it —
    // that is what makes the claims/{uid} check below meaningful.
    match /config/{doc} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Write-once proof that the caller typed the right invite code, checked
    // against config/invite server-side. Never readable, never updatable, so a
    // claim can only ever be spent once per uid.
    match /claims/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code ==
             get(/databases/$(database)/documents/config/invite).data.code;
      allow read, update: if false;
      // deleting an account from the admin panel removes its claim too
      allow delete: if isAdmin();
    }

    // Tombstone written when the admin deletes an account. A deleted account
    // can never create a profile again, and the game reads this to tell
    // that player plainly what happened.
    match /deleted/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list, create, update, delete: if isAdmin();
    }

    // Admin-awarded season podiums, e.g. seasonAwards/s1 =
    // { gold: {uid, name}, silver: {uid, name}, bronze: {uid, name} } —
    // one document per season, so there is exactly one of each place.
    match /seasonAwards/{season} {
      allow get, list: if signedIn();
      allow write: if isAdmin();
    }

    match /profiles/{uid} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/claims/$(uid))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 14
        && request.resource.data.banned == false
        && !exists(/databases/$(database)/documents/deleted/$(uid));
      // displayName is fixed to the username at signup and never editable —
      // only an admin may touch a profile after creation (banning).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']);
      allow delete: if isAdmin();
    }

    // Doc id must be "{uid}_{courseId}" so a player can only ever hold their own
    // row per course. displayName/banned are denormalised from profiles/{uid} so
    // the leaderboard can filter without a join — the rule forces them to match.
    // Admins additionally get a narrow update path that touches only `banned`,
    // which is how a ban actually gets hidden from the leaderboard: the owner
    // write path can't do it, since request.auth.uid there is the admin, not
    // the row's own player.
    match /bests/{docId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn()
        && docId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName == myProfile().displayName
        && request.resource.data.banned == myProfile().banned
        && request.resource.data.timeMs is number
        && request.resource.data.timeMs > 0
        && request.resource.data.timeMs < 600000;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']);
      // A player may delete their own row (Settings > reset scores); an
      // admin may delete any row (a suspicious time). Checked against the
      // uid prefix baked into the doc id itself, not resource.data — a
      // delete on a course the player never cleared targets a document
      // that was never created, so resource is null and reading its data
      // would fail the rule outright instead of just evaluating false.
      allow delete: if isAdmin()
        || (signedIn() && docId.split('_')[0] == request.auth.uid);
    }

    // Four shapes of credit event, every one create-only and never mutable:
    //   {uid}_{courseId}_clear   campaign clear bonus, delta==100, once per
    //                            course (the doc id itself is the lock).
    //   {uid}_{anything}_grind   credits-grind mode: +1 per completed random
    //                            course, intentionally repeatable, so unlike
    //                            _clear the id has no fixed course/lock —
    //                            the cap is delta==1 exactly, every time.
    //   {uid}_{raceId}_buyin     a player staking into a race they joined —
    //                            a self-authorised debit, delta<0. Not
    //                            cross-checked against the entry doc's own
    //                            buyIn: both are written in the same client
    //                            call, and rules evaluate each write in a
    //                            batch against the state before the batch
    //                            runs, so a same-batch get() of the entry
    //                            document would never see it and always
    //                            fail. Same trust level as a lap time —
    //                            self-reported, moderated after the fact.
    //   {uid}_{raceId}_payout    a race payout. There is no admin/backend
    //                            role in race settlement any more — any
    //                            signed-in player's client may notice the
    //                            race timer ran out and write every
    //                            finisher's payout, same trust level a lap
    //                            time already has (self-reported, not
    //                            cross-checked against the pot here for
    //                            the same batch-visibility reason the
    //                            _buyin case above can't be cross-checked
    //                            either — moderated after the fact, not
    //                            enforced at write time). delta may be
    //                            zero (a DNF-refund-everyone settlement
    //                            still "pays out" each player their own
    //                            buy-in back) but never negative — a
    //                            payout can't also be used to debit.
    //   {uid}_{anything}_adjust  an admin manually setting a player's
    //                            balance from the panel — any sign, any
    //                            size, purely at admin discretion.
    //   {uid}_{anything}_color   buying a car-color pack — always exactly
    //                            delta==-10, repeatable like _grind. The
    //                            resulting color itself is a client-rolled
    //                            random pick, written separately to
    //                            carCustomization/{uid} — same trust level
    //                            as everything else self-reported here.
    match /creditEvents/{docId} {
      allow get, list: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid
        && (
          (docId == request.auth.uid + '_' + request.resource.data.courseId + '_clear'
            && request.resource.data.delta == 100)
          || (docId.matches(request.auth.uid + '_.+_grind')
            && request.resource.data.delta == 1)
          || (docId == request.auth.uid + '_' + request.resource.data.raceId + '_buyin'
            && request.resource.data.delta is number
            && request.resource.data.delta < 0 && request.resource.data.delta > -1000000)
          || (docId.matches(request.auth.uid + '_.+_color')
            && request.resource.data.delta == -10)
        ))
        || (signedIn() && docId.matches('.+_' + request.resource.data.raceId + '_payout')
            && request.resource.data.delta is number
            && request.resource.data.delta >= 0 && request.resource.data.delta < 1000000)
        || (isAdmin() && docId.matches(request.resource.data.uid + '_.+_adjust')
            && request.resource.data.delta is number);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // One document per player: every color they've unlocked (each bought
    // for 10 credits, see creditEvents' _color shape above) plus which two
    // are currently equipped. HSL rather than RGB so the two color-pack
    // shapes (a straight hue pick, and a saturation/brightness pick around
    // an existing hue) are both simple, exact range checks. The actual
    // random roll happens client-side — same trust level as a lap time or
    // a credits-grind completion, nothing here to cheaply verify server-
    // side, and nothing worth cheating (a color has no gameplay effect).
    match /carCustomization/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.unlocked is list
        && request.resource.data.unlocked.size() <= 500
        && request.resource.data.primary is map
        && request.resource.data.secondary is map
        && isHsl(request.resource.data.primary)
        && isHsl(request.resource.data.secondary);
      allow delete: if isAdmin();
    }

    // Append-only history of every attempt — campaign, credits-run or race,
    // finished, restarted or cut short (outcome) — written by the player's
    // own client the moment that attempt ends, purely for the admin panel's run history
    // and statistics. Same trust level as everything else self-reported
    // here (a lap time, a credits-grind completion): nothing server-side
    // can verify a claimed timeMs actually happened, so this is moderated
    // after the fact like the rest, not enforced at write time. Never
    // readable by players themselves — there is no player-facing feature
    // that needs it, and it would otherwise let one player enumerate
    // every other player's entire play history.
    match /runLog/{docId} {
      allow get, list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['campaign', 'creditsrun', 'race']
        && request.resource.data.courseId is string
        && request.resource.data.timeMs is number
        && request.resource.data.timeMs > 0 && request.resource.data.timeMs < 600000
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(['outcome'])
            || request.resource.data.outcome in ['finished', 'restarted', 'terminated']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Doc id "{uid}_{courseId}". Ghosts are read by anyone racing that run, but
    // only their owner can write one, and samples are capped so a malicious
    // client can't burn the free-tier 1 GiB storage quota with one write.
    match /ghosts/{docId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && docId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timeMs is number
        && request.resource.data.samples is string
        && request.resource.data.samples.size() < 60000;
      // A player may delete their own ghost (Settings > reset scores); an
      // admin may delete any ghost. Checked against the doc id itself, not
      // resource.data — see the identical note on bests' delete rule.
      allow delete: if isAdmin()
        || (signedIn() && docId.split('_')[0] == request.auth.uid);
    }

    // Admin-free buy-in races. There is no backend, so every transition
    // below is triggered by whichever signed-in player's client notices
    // it should happen — the same trust level lap times already have.
    // Each rule constrains the *shape* of one specific state transition,
    // not who may attempt it; nothing here can verify e.g. "were there
    // really 2+ entries" (a subcollection count isn't cheaply readable
    // from a rule), so that safety property is enforced by client logic
    // choosing when to attempt the write, not by the rule itself.
    //
    // States: lobby -> starting -> running -> settled.
    //   lobby     just created, no courseId yet, players joining.
    //   starting  2+ joined; a 60s joinDeadline is set so late arrivals
    //             can still get in before the course is picked.
    //   running   joinDeadline passed; courseId chosen and written for
    //             the first time here — this is also what makes "you
    //             can't see the course before it starts" true: the field
    //             simply doesn't exist before this transition, and
    //             Firestore has no per-field read restriction, so this
    //             is the only honest way to hide it.
    //   settled   endsAt passed; payouts written to creditEvents
    //             separately (see creditEvents' _payout case above).
    match /races/{raceId} {
      allow get, list: if signedIn();

      // Anyone may open the next lobby once none is open. Two players'
      // clients racing to do this is harmless — whichever create lands
      // first wins, the loser's local state just gets corrected by the
      // next snapshot of the query that found nothing open.
      allow create: if signedIn()
        && request.resource.data.state == 'lobby'
        && !request.resource.data.keys().hasAny(['courseId'])
        && request.resource.data.pot == 0;

      // lobby -> starting: only state + joinDeadline change, and the
      // deadline must actually be in the future (roughly now+60s, given
      // some slack for the writer's own clock).
      allow update: if signedIn()
        && resource.data.state == 'lobby' && request.resource.data.state == 'starting'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['state', 'joinDeadline'])
        && request.resource.data.joinDeadline is timestamp
        && request.resource.data.joinDeadline > request.time;

      // starting -> running: only once the join window has genuinely
      // elapsed; picks and locks in the course for the first time.
      allow update: if signedIn()
        && resource.data.state == 'starting' && request.resource.data.state == 'running'
        && request.time >= resource.data.joinDeadline
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['state', 'courseId', 'startedAt', 'endsAt'])
        && request.resource.data.courseId is string
        && request.resource.data.startedAt is timestamp
        && request.resource.data.endsAt is timestamp;

      // running -> settled: only once the race clock has genuinely run
      // out; payouts themselves are separate creditEvents writes, not
      // part of this document at all.
      allow update: if signedIn()
        && resource.data.state == 'running' && request.resource.data.state == 'settled'
        && request.time >= resource.data.endsAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['state', 'settledBy'])
        && request.resource.data.settledBy == request.auth.uid;

      allow delete: if false;

      match /entries/{uid} {
        allow get, list: if signedIn();
        // A player creates their own entry once, when they join — the
        // buyIn is fixed at that moment and never changes afterward.
        // Joining is only meaningful before the course is locked in, so
        // this is restricted to lobby/starting, checked via the parent
        // race document.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.buyIn is number
          && request.resource.data.buyIn > 0 && request.resource.data.buyIn < 1000000
          && request.resource.data.attempts == []
          && request.resource.data.keys().hasOnly(
               ['uid', 'displayName', 'buyIn', 'attempts', 'bestTimeMs'])
          && get(/databases/$(database)/documents/races/$(raceId)).data.state in ['lobby', 'starting'];
        // Recording attempts is the player's own job as they drive.
        // Capped at 3 attempts server-side, not just by the UI hiding the
        // Drive button once used up — that hides the button, it does not
        // stop a direct write.
        allow update: if signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['attempts', 'bestTimeMs'])
              && request.resource.data.attempts.size() <= 3;
        // Setting placement/payout is settlement's job, done once by
        // whichever signed-in player's client notices the race clock ran
        // out — there is no admin gate any more, so this is checked the
        // same way the race document's own running->settled transition
        // is: only once the parent race is actually running and endsAt
        // has genuinely passed. (Rules can't see sibling writes in the
        // same batch, so this can't also require the race doc to already
        // read back as 'settled' — the timing check on the race's own
        // endsAt is the equivalent guarantee.)
        allow update: if signedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['placement', 'payout'])
              && get(/databases/$(database)/documents/races/$(raceId)).data.state == 'running'
              && request.time >= get(/databases/$(database)/documents/races/$(raceId)).data.endsAt;
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
